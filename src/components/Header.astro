---
import { SITE, url } from '../config';

// Menu links: [key, url, label]
const { current, exact = true } = Astro.props;
const links = [
  ['home', '/', 'الرئيسية'],
  ['posts', '/posts/', 'جميع التدوينات']
  //['about', '/about/', 'عني'],
];
---
<header class="nav">
  <div class="wrap">
<a class="logo" href={url('/')}>{SITE.name}</a>
    <nav aria-label="القائمة الرئيسية">
      <ul>
        {links.map(([key, href, label]) => (
          <li><a href={url(href)} aria-current={key === current ? (exact ? 'page' : 'true') : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="toggle" id="theme" type="button" aria-label="تبديل الوضع الليلي"></button>
  </div>
</header>
