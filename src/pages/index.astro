---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import { getPosts, fmt, iso } from '../utils';
import { url } from '../config';
const all = await getPosts();
const latest = all[0];
// The newest post is the big card; the next 6 are the small cards.
const cards = all.slice(1, 7);
---
<Base current="home">
<main>
  {latest && (
    <section class="latest">
      <div class="wrap">
        <p class="small-h">أحدث تدوينة</p>
        <div class="feature">
          <a class="feature-link" href={url('/posts/' + latest.id + '/')} aria-hidden="true" tabindex="-1"></a>
          <div class="feature-text">
           <h1><a href={url('/posts/' + latest.id + '/')}>{latest.data.title}</a></h1>
            <time class="date" datetime={iso(latest.data.date)}>{fmt(latest.data.date)}</time>
            <p>{latest.data.caption}</p>
            <a class="pill" href={url('/posts/' + latest.id + '/')}>اقرأ التدوينة <span aria-hidden="true">←</span></a>
          </div>
          <div class="ph">
            {latest.data.cover ? <Image src={latest.data.cover} alt="" widths={[640, 1100, 1600, 2200]} sizes="(max-width: 1180px) 100vw, 1132px" loading="eager" /> : ''}
          </div>
        </div>
      </div>
    </section>
  )}

  {cards.length > 0 && (
    <section class="posts">
      <div class="wrap">
        <div class="sec-head">
          <h2> أخرى</h2>
          <a class="pill" href={url('/posts/')}>جميع التدوينات <span aria-hidden="true">←</span></a>
        </div>
        <div class="grid">
          {cards.map((p, i) => <Card post={p} extra={i >= 2} />)}
        </div>
        {cards.length > 2 && (
          <div class="more">
            <button type="button" class="pill show-more" id="show-more">عرض المزيد <span aria-hidden="true">+</span></button>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="quote">
    <div class="wrap">
      <blockquote><span class="q" aria-hidden="true">❞</span> ستبقى كل حقيقة من الحقائق الكبرى — كالإيمان، والجمال، والحب، والخير، والحق — ستبقى محتاجةً في كل عصرٍ إلى كتابةٍ جديدة من أذهانٍ جديدة. <span class="q" aria-hidden="true">❝</span><cite>مصطفى الرافعي</cite></blockquote>
    </div>
  </section>
</main>
<script is:inline>
(function(){
  // Phones only: 2 cards show first, each click reveals 2 more.
  var btn=document.getElementById('show-more');
  if(!btn) return;
  var extras=[].slice.call(document.querySelectorAll('.card.extra'));
  var shown=0;
  btn.addEventListener('click',function(){
    extras.slice(shown,shown+2).forEach(function(c){c.classList.add('shown')});
    shown+=2;
    if(shown>=extras.length) btn.classList.add('done');
  });
})();
</script>
</Base>